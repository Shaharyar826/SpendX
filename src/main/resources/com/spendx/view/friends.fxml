<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.spendx.controller.FriendsController"
            prefWidth="800" prefHeight="560"
            style="-fx-background-color: #1e1e2e;">
    <top>
        <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-background-color: #181825; -fx-padding: 14 20;">
            <Label text="Friends" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #cba6f7;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Back" onAction="#goBack" style="-fx-background-color: #45475a; -fx-text-fill: #cdd6f4; -fx-background-radius: 6;"/>
        </HBox>
    </top>
    <center>
        <HBox spacing="20" style="-fx-padding: 20;">
            <!-- Search & Add -->
            <VBox spacing="10" prefWidth="240">
                <Label text="Find Users" style="-fx-text-fill: #a6adc8;"/>
                <HBox spacing="8">
                    <TextField fx:id="searchField" promptText="Search username..." HBox.hgrow="ALWAYS"
                               style="-fx-background-color: #313244; -fx-text-fill: #cdd6f4; -fx-prompt-text-fill: #6c7086; -fx-background-radius: 6; -fx-padding: 8;"/>
                    <Button text="Search" onAction="#handleSearch"
                            style="-fx-background-color: #89b4fa; -fx-text-fill: #1e1e2e; -fx-background-radius: 6;"/>
                </HBox>
                <ListView fx:id="searchResultsList" prefHeight="160"
                          style="-fx-background-color: #313244; -fx-control-inner-background: #313244; -fx-text-fill: #cdd6f4;"/>
                <Button text="Send Friend Request" onAction="#sendRequest" maxWidth="Infinity"
                        style="-fx-background-color: #a6e3a1; -fx-text-fill: #1e1e2e; -fx-background-radius: 6;"/>
            </VBox>

            <!-- Friends List -->
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label text="My Friends" style="-fx-text-fill: #a6adc8;"/>
                <ListView fx:id="friendsList" VBox.vgrow="ALWAYS"
                          style="-fx-background-color: #313244; -fx-control-inner-background: #313244; -fx-text-fill: #cdd6f4;"/>
                <Button text="Remove Friend" onAction="#removeFriend"
                        style="-fx-background-color: #f38ba8; -fx-text-fill: #1e1e2e; -fx-background-radius: 6;"/>
            </VBox>

            <!-- Requests -->
            <VBox spacing="10" prefWidth="220">
                <Label text="Pending Requests" style="-fx-text-fill: #a6adc8;"/>
                <ListView fx:id="requestsList" VBox.vgrow="ALWAYS"
                          style="-fx-background-color: #313244; -fx-control-inner-background: #313244; -fx-text-fill: #cdd6f4;"/>
                <HBox spacing="8">
                    <Button text="Accept" onAction="#acceptRequest" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #a6e3a1; -fx-text-fill: #1e1e2e; -fx-background-radius: 6;"/>
                    <Button text="Reject" onAction="#rejectRequest" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #f38ba8; -fx-text-fill: #1e1e2e; -fx-background-radius: 6;"/>
                </HBox>
            </VBox>
        </HBox>
    </center>
    <bottom>
        <Label fx:id="statusLabel" style="-fx-text-fill: #fab387; -fx-padding: 8 20;" text=""/>
    </bottom>
</BorderPane>

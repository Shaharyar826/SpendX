<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.spendx.controller.SignupController"
      alignment="CENTER" spacing="12" prefWidth="400" prefHeight="500"
      style="-fx-background-color: #1e1e2e; -fx-padding: 40;">

    <Label text="Create Account" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #cba6f7;"/>

    <TextField fx:id="fullNameField" promptText="Full Name"
               style="-fx-background-color: #313244; -fx-text-fill: #cdd6f4; -fx-prompt-text-fill: #6c7086; -fx-background-radius: 8; -fx-padding: 10;"/>
    <TextField fx:id="usernameField" promptText="Username"
               style="-fx-background-color: #313244; -fx-text-fill: #cdd6f4; -fx-prompt-text-fill: #6c7086; -fx-background-radius: 8; -fx-padding: 10;"/>
    <TextField fx:id="emailField" promptText="Email"
               style="-fx-background-color: #313244; -fx-text-fill: #cdd6f4; -fx-prompt-text-fill: #6c7086; -fx-background-radius: 8; -fx-padding: 10;"/>
    <PasswordField fx:id="passwordField" promptText="Password"
                   style="-fx-background-color: #313244; -fx-text-fill: #cdd6f4; -fx-prompt-text-fill: #6c7086; -fx-background-radius: 8; -fx-padding: 10;"/>
    <PasswordField fx:id="confirmPasswordField" promptText="Confirm Password"
                   style="-fx-background-color: #313244; -fx-text-fill: #cdd6f4; -fx-prompt-text-fill: #6c7086; -fx-background-radius: 8; -fx-padding: 10;"/>

    <Label fx:id="errorLabel" style="-fx-text-fill: #f38ba8; -fx-font-size: 12;" text=""/>

    <Button text="Sign Up" onAction="#handleSignup" maxWidth="Infinity"
            style="-fx-background-color: #a6e3a1; -fx-text-fill: #1e1e2e; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10;"/>

    <HBox alignment="CENTER" spacing="6">
        <Label text="Already have an account?" style="-fx-text-fill: #a6adc8;"/>
        <Hyperlink text="Login" onAction="#goToLogin" style="-fx-text-fill: #89b4fa;"/>
    </HBox>
</VBox>

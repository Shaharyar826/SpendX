<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.spendx.controller.ReportsController"
            prefWidth="700" prefHeight="500"
            style="-fx-background-color: #1e1e2e;">
    <top>
        <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-background-color: #181825; -fx-padding: 14 20;">
            <Label text="Reports &amp; Analytics" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #cba6f7;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Back" onAction="#goBack" style="-fx-background-color: #45475a; -fx-text-fill: #cdd6f4; -fx-background-radius: 6;"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="16" style="-fx-padding: 24;">
            <Label fx:id="totalSpentLabel" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #cdd6f4;"/>
            <HBox spacing="20">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="By Category" style="-fx-text-fill: #a6adc8;"/>
                    <ListView fx:id="categoryReportList" prefHeight="280"
                              style="-fx-background-color: #313244; -fx-control-inner-background: #313244; -fx-text-fill: #cdd6f4;"/>
                </VBox>
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="By Month" style="-fx-text-fill: #a6adc8;"/>
                    <ListView fx:id="monthlyReportList" prefHeight="280"
                              style="-fx-background-color: #313244; -fx-control-inner-background: #313244; -fx-text-fill: #cdd6f4;"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>

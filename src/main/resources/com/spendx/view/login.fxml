<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.spendx.controller.LoginController"
      alignment="CENTER" spacing="14" prefWidth="380" prefHeight="420"
      style="-fx-background-color: #1e1e2e; -fx-padding: 40;">

    <Label text="Spendx" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #cba6f7;"/>
    <Label text="Sign in to your account" style="-fx-text-fill: #a6adc8; -fx-font-size: 13;"/>

    <TextField fx:id="usernameField" promptText="Username"
               style="-fx-background-color: #313244; -fx-text-fill: #cdd6f4; -fx-prompt-text-fill: #6c7086; -fx-background-radius: 8; -fx-padding: 10;"/>

    <PasswordField fx:id="passwordField" promptText="Password"
                   style="-fx-background-color: #313244; -fx-text-fill: #cdd6f4; -fx-prompt-text-fill: #6c7086; -fx-background-radius: 8; -fx-padding: 10;"/>

    <Label fx:id="errorLabel" style="-fx-text-fill: #f38ba8; -fx-font-size: 12;" text=""/>

    <Button text="Login" onAction="#handleLogin" maxWidth="Infinity"
            style="-fx-background-color: #cba6f7; -fx-text-fill: #1e1e2e; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10;"/>

    <HBox alignment="CENTER" spacing="6">
        <Label text="Don't have an account?" style="-fx-text-fill: #a6adc8;"/>
        <Hyperlink text="Sign up" onAction="#goToSignup" style="-fx-text-fill: #89b4fa;"/>
    </HBox>
</VBox>
